{
  "name": "prameshstha/laravel-exception-reporter",
  "description": "Reusable Mailgun HTTP email service and global exception reporter for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "mailgun",
    "exceptions",
    "notifications"
  ],
  "require": {
    "php": "^8.0",
    "guzzlehttp/guzzle": "^7.2",
    "illuminate/support": "^8.0|^12.0|^13.0",
    "illuminate/contracts": "^8.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^6.0|^10.0|^11.0",
    "phpunit/phpunit": "^9.5|^10.5|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Pramesh\\LaravelExceptionReporter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pramesh\\LaravelExceptionReporter\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pramesh\\LaravelExceptionReporter\\ExceptionReporterServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "config": {
    "sort-packages": true
  }
}
